# Copy to .env and adjust. Values di sini adalah default docker-compose.

# Postgres (bind 127.0.0.1 by default)
POSTGRES_DB=axisbridge
POSTGRES_USER=axis
POSTGRES_PASSWORD=axispass
POSTGRES_PORT=5000

# axis-core (bind 127.0.0.1)
CORE_PORT=5001

# OVO wallet vault. Encrypts PINs and cached tokens at rest (AES-256-GCM).
# 32 bytes, raw or hex/base64. Generate with:
#   openssl rand -hex 32
# Leave empty to run without OVO: the /api/ovo endpoints then refuse instead
# of storing PINs in the clear. Losing this key means every wallet must be
# re-entered, so back it up outside the repo.
OVO_MASTER_KEY=

# axis-ui (bind bebas via UI_BIND)
UI_PORT=5002
UI_BIND=0.0.0.0     # set 127.0.0.1 kalau UI dilayani lewat Caddy/Nginx
# UI has no built-in authentication; protect it via a reverse proxy if exposed publicly.

# workers
REGISTER_CONCURRENCY=2
GIFT_CONCURRENCY=1

LOG_LEVEL=info
